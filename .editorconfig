root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# dois espaços no fim da linha são quebra de linha no Markdown
trim_trailing_whitespace = false

[*.py]
indent_size = 4

[*.{bat,cmd,ps1}]
end_of_line = crlf

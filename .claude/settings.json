{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Skill",
      "Agent",
      "Bash(pnpm mce *)",
      "Bash(pnpm test*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm exec vitest *)",
      "Bash(pnpm exec tsc *)",
      "Bash(ffprobe *)",
      "PowerShell(pnpm mce *)",
      "PowerShell(pnpm test*)",
      "PowerShell(pnpm typecheck*)",
      "PowerShell(pnpm exec vitest *)",
      "PowerShell(pnpm exec tsc *)",
      "PowerShell(ffprobe *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Bash(rm -rf *)",
      "PowerShell(Remove-Item * -Recurse *)"
    ]
  }
}

node_modules/
dist/

# segredos e configuração local (o tópico do ntfy em mce.config.json funciona como senha)
.env
.env.*
mce.config.json
.claude/settings.local.json

# ── vídeos: nada do que entra ou sai do pipeline vai para o git ──
# brutos enviados (inclusive inbox/limpa, inbox/normal, inbox/pro, inbox/max)
inbox/*
!inbox/.gitkeep
# entregas: final.mp4, final-shorts.mp4, capas, título, descrição, relatório
output/*
!output/.gitkeep
# trabalho por vídeo: proxy, transcrição, EDLs, renders, frames de capa, prévias do visor, stills
projects/*
!projects/.gitkeep

# rede de segurança: mídia nunca é versionada, esteja onde estiver
*.mp4
*.mov
*.mkv
*.m4v
*.webm
*.avi
*.wmv
*.flv
*.mts
*.m2ts
*.ts.mp4
*.mxf
*.prores
*.wav
*.mp3
*.m4a
*.aac
*.flac
*.ogg
*.opus
*.pcm
*.wma
*.aif
*.aiff
*.mka
*.ogv
*.3gp
*.srt
*.vtt
*.lrc
# exceção: os efeitos sonoros-base, sintetizados por `mce assets init` (livres de direitos, poucos KB)
!assets/sfx/*.wav

# biblioteca pessoal: trilhas, memes, LUTs e material de marca ficam só na máquina
assets/music/*
assets/memes/*
assets/luts/*
assets/brand/*
# b-roll: os vídeos e o índice (com origem/licença) ficam só na máquina
assets/broll/*
# fundos trocáveis (imagem/vídeo do `background` da EDL): material do usuário, só na máquina
assets/backgrounds/*
!assets/*/.gitkeep
!assets/memes/placeholder.png

# saídas avulsas do Remotion
out/
motion/out/
motion/public/*.mp4
motion/public/*.mov

# letras de música (texto do usuário, muitas vezes com direitos autorais): só na máquina
letras/
lyrics/
**/letra*.txt
**/lyrics*.txt

# sidecar Python
transcriber/.venv/
transcriber/.cache/
matting/.venv/
matting/models/
# modelos baixados (RVM etc.), onde quer que estejam
*.torchscript
*.pth
*.onnx
__pycache__/
*.pyc

# estado local
.queue/
# servidores de prévia ao vivo (PIDs e projeto atual, scripts/ensure-preview.mjs)
.preview/
*.log
.DS_Store
Thumbs.db

# build da UI do MChiodi Cut (pnpm cut:build)
cut/dist/
music-preview/dist/
